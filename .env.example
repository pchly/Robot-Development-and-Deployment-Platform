# Optional control-plane state location. Leave unset to use
# services/platform-api/.data/control-plane.sqlite3.
ROBOT_PLATFORM_DB_PATH=

# Optional Catalog root. Leave unset to scan this repository.
ROBOT_PLATFORM_ASSET_ROOT=

# Optional Agent plugin search path and managed data root.
ROBOT_EDGE_PLUGIN_PATH=
ROBOT_EDGE_DATA_ROOT=

# compose.yaml development ports.
PLATFORM_API_PORT=8000
STUDIO_PORT=5173
