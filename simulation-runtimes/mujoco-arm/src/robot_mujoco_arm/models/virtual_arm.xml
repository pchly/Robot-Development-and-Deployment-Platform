<mujoco model="robot_platform_virtual_arm">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.8 0.8 0.8"/>
  </visual>
  <default>
    <joint damping="1.5" armature="0.03" limited="true"/>
    <geom type="capsule" size="0.035" density="900" rgba="0.18 0.55 0.38 1"/>
    <position kp="80" kv="12" ctrllimited="true" forcelimited="true" forcerange="-80 80"/>
  </default>
  <asset>
    <material name="floor" rgba="0.18 0.22 0.20 1"/>
  </asset>
  <worldbody>
    <light pos="1 -1 2" dir="-1 1 -2"/>
    <geom name="floor" type="plane" size="2 2 0.1" material="floor"/>
    <body name="target" mocap="true" pos="0.25 0 0.45">
      <geom type="sphere" size="0.025" rgba="0.95 0.25 0.18 0.65" contype="0" conaffinity="0"/>
    </body>
    <body name="base" pos="0 0 0.06">
      <geom type="cylinder" size="0.10 0.06" rgba="0.12 0.18 0.16 1"/>
      <joint name="shoulder_pan" type="hinge" axis="0 0 1" range="-3.05 3.05"/>
      <body name="shoulder" pos="0 0 0.08">
        <joint name="shoulder_lift" type="hinge" axis="0 1 0" range="-2.2 2.2"/>
        <geom fromto="0 0 0 0 0 0.25"/>
        <body name="upper_arm" pos="0 0 0.25">
          <joint name="elbow" type="hinge" axis="0 1 0" range="-2.6 2.6"/>
          <geom fromto="0 0 0 0 0 0.22" rgba="0.22 0.68 0.46 1"/>
          <body name="forearm" pos="0 0 0.22">
            <joint name="wrist_roll" type="hinge" axis="1 0 0" range="-3.05 3.05"/>
            <geom fromto="0 0 0 0 0 0.12" size="0.03"/>
            <body name="wrist" pos="0 0 0.12">
              <joint name="wrist_pitch" type="hinge" axis="0 1 0" range="-2.4 2.4"/>
              <geom fromto="0 0 0 0 0 0.09" size="0.025"/>
              <body name="tool" pos="0 0 0.09">
                <joint name="wrist_yaw" type="hinge" axis="0 0 1" range="-3.05 3.05"/>
                <geom type="cylinder" size="0.035 0.04" rgba="0.75 0.78 0.76 1"/>
                <site name="tool_center" pos="0 0 0.08" size="0.015" rgba="0.2 0.65 1 1"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="a_shoulder_pan" joint="shoulder_pan" ctrlrange="-3.05 3.05"/>
    <position name="a_shoulder_lift" joint="shoulder_lift" ctrlrange="-2.2 2.2"/>
    <position name="a_elbow" joint="elbow" ctrlrange="-2.6 2.6"/>
    <position name="a_wrist_roll" joint="wrist_roll" ctrlrange="-3.05 3.05"/>
    <position name="a_wrist_pitch" joint="wrist_pitch" ctrlrange="-2.4 2.4"/>
    <position name="a_wrist_yaw" joint="wrist_yaw" ctrlrange="-3.05 3.05"/>
  </actuator>
</mujoco>
