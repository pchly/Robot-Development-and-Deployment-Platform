ARG BASE_IMAGE=nvcr.io/nvidia/l4t-base:r36.2.0

FROM ${BASE_IMAGE}
ARG DEBIAN_FRONTEND=noninteractive
ARG PYREALSENSE_WHEEL=pyrealsense2-2.58.4.10922-cp310-cp310-manylinux2014_aarch64.whl

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libudev1 \
        libusb-1.0-0 \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

COPY vendor/${PYREALSENSE_WHEEL} /tmp/${PYREALSENSE_WHEEL}
RUN python3 -m pip install --no-cache-dir --no-deps "/tmp/${PYREALSENSE_WHEEL}" \
    && rm -f "/tmp/${PYREALSENSE_WHEEL}"

COPY probe.py /opt/robot-runtime/probe.py
COPY camera_runtime.py /opt/robot-runtime/camera_runtime.py

ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python3", "/opt/robot-runtime/probe.py"]
